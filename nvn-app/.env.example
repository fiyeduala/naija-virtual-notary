APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging. 'daily' writes a dated file and drops anything older than
# LOG_DAILY_DAYS; 'single' is one laravel.log that grows until the disk quota
# stops the site — and on shared hosting that quota also holds the database and
# the sealed PDFs. In production set LOG_LEVEL=info: debug is most of the
# volume and almost none of what you ever go back and read.
LOG_CHANNEL=stack
LOG_STACK=daily
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Stored in `http_sessions`, not `sessions` — the latter is this application's
# video verification sessions. See config/session.php.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on any server reached over HTTPS, which is every one but a laptop.
# It marks the session cookie Secure, so a browser will not send it over
# plain HTTP, which is how a session is stolen off an untrusted network.
# Left false here only because this file is also what a local install copies.
SESSION_SECURE_COOKIE=false

# Security headers — see app/Http/Middleware/SecurityHeaders.php.
# The Content-Security-Policy ships report-only: the browser blocks nothing and
# posts what it would have blocked to /csp-report, which is logged. Read that
# log, fix what the policy got wrong, and only then set NVN_CSP_ENFORCE=true.
NVN_CSP_ENABLED=true
NVN_CSP_ENFORCE=false
# Strict-Transport-Security, sent only on an HTTPS response. One year.
# Subdomains stay out by default: this app sits on a subdomain of a domain
# that hosts other things, and including them makes a promise for sites this
# code knows nothing about. Do not add preload.
NVN_HSTS_MAX_AGE=31536000
NVN_HSTS_INCLUDE_SUBDOMAINS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds the scheduled worker may run before exiting. The worker stops as soon
# as the queue is empty, so this only binds when there is a backlog, and then it
# sets what share of the clock the queue gets. Defaults to 290, which suits both
# a per-minute cron and the five-minute floor some shared hosts impose. Lower it
# only for a host that limits process time, and never above the
# withoutOverlapping() mutex in routes/console.php (10 minutes).
# NVN_QUEUE_MAX_TIME=290

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tawk.to live chat. Blank property ID = no widget loaded anywhere.
# Both IDs come from the embed URL Tawk gives you:
#   https://embed.tawk.to/<TAWK_PROPERTY_ID>/<TAWK_WIDGET_ID>
# These are only fallbacks — Platform settings in the admin panel overrides them.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=default

# ── Importing the old WordPress site ─────────────────────────────────────
# Only `php artisan nvn:import-wordpress` reads any of this, and only ever
# with SELECT. Once the import is verified these can all be removed.
#
# Give it a MySQL user with SELECT and nothing else if you can — then the
# old site is protected by the database rather than by this code being
# careful. Leave WP_DB_DATABASE blank and the command refuses to run.
WP_DB_DATABASE=
WP_DB_USERNAME=
WP_DB_PASSWORD=
WP_TABLE_PREFIX=wp_
# The WordPress document root on disk. CFDB7 keeps uploads on the filesystem
# and only their filenames in the database, so without this the accounts
# still import and every attachment is skipped.
WP_PATH=
# Contact Form 7 form IDs, from wp_posts where post_type='wpcf7_contact_form'.
# A rebuilt form gets a new ID and would otherwise match nothing, silently.
WP_FORM_REQUEST=656
WP_FORM_APPLICATION=560
WP_FORM_CONFIRMATION=690

# ── Verification call video ──────────────────────────────────────────────
# 'daily' | 'agora' (skeleton) | 'manual' (no live call, preview mode only).
VIDEO_PROVIDER=daily
# Daily dashboard → Developers → API key.
DAILY_API_KEY=
# Your Daily subdomain: either 'yourteam' or 'yourteam.daily.co'.
DAILY_DOMAIN=
# Optional. Defaults shown.
# DAILY_ROOM_TTL_MINUTES=240
# DAILY_MAX_PARTICIPANTS=5
# DAILY_PREJOIN_UI=true
# DAILY_TIMEOUT=6
#
# The call is never recorded. Leave recording UNSET on your Daily domain —
# a domain-level default is the one thing that could switch it on behind the
# app's back, and `php artisan nvn:video-check` will warn you if it is.

# Meta (Facebook) ads — conversion tracking. Both blank = tracking off entirely.
# Dataset ID from Events Manager; the token belongs to a System User with
# ads_management and is as sensitive as PAYSTACK_SECRET_KEY.
META_DATASET_ID=
META_CAPI_TOKEN=
# Set while proving the plumbing; events sent with it do NOT optimise. Remove after.
META_TEST_EVENT_CODE=
# Bump if nvn:meta-check reports the Graph API version has been retired.
META_API_VERSION=v23.0

# Audit log — how the oldest entries were sealed, when that differs from now.
# An audit hash covers the timestamp written out with its UTC offset, and that
# offset comes from APP_TIMEZONE. Change APP_TIMEZONE and every row written
# before the change stops verifying, while nothing in the table has moved.
# These two record where that boundary falls so those rows are checked against
# the offset they were actually written with. Leave blank on a new install:
# there is no boundary until APP_TIMEZONE has moved at least once. Never widen
# the range to cover a row you have not first explained with nvn:audit-check.
AUDIT_LEGACY_TIMEZONE=
AUDIT_LEGACY_THROUGH_ID=

# Recruitment — how fast candidate email is allowed to leave.
# A ceiling per rolling hour on paceable mail: acknowledgements, exercise
# invitations, reminders and declines. Sign-in links, interviews, offers and
# receipts ignore it and are not counted against it, because somebody is
# waiting on those and a sign-in link expires in thirty minutes.
# Set this below whatever hourly relay cap your host enforces — exceeding
# theirs produces bounces from our own server, which costs more reputation
# than sending slowly. 0 removes the ceiling entirely.
NVN_RECRUITMENT_PER_HOUR=100
