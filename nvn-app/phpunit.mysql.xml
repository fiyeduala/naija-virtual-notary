<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same tests as phpunit.xml, run against MariaDB instead of SQLite. The connection driver is still "mysql".

    The live server runs MariaDB (a MySQL fork), and some behaviour only shows up there: how a
    TIMESTAMP column round-trips, InnoDB row locks, strict-mode rejections,
    integer columns coming back as strings. SQLite cannot catch any of those.

    This is meant for GitHub Actions, which starts a disposable MariaDB server
    for each run and throws it away afterwards. Every setting is forced so
    that a .env cannot redirect it, and the database must be named *_testing
    — tests/TestCase.php refuses to run against anything else.

    Run with:  vendor/bin/phpunit -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="nvn_testing" force="true"/>
        <!--
            utf8mb4_0900_ai_ci, which Laravel 11 defaults to, is a MySQL 8
            collation that MariaDB does not have — the connector sends it in a
            SET NAMES on connect, so every query dies with "1273 Unknown
            collation". Set here as well as in config/database.php so a test run
            says out loud which collation it is proving.
        -->
        <env name="DB_CHARSET" value="utf8mb4" force="true"/>
        <env name="DB_COLLATION" value="utf8mb4_unicode_ci" force="true"/>
        <!--
            Credentials are NOT forced: they are the one thing that differs
            between GitHub's throwaway server (root/root, set on the workflow
            step) and whatever MariaDB a developer has locally. Without them
            config/database.php falls back to root with no password, which is
            what a stock XAMPP or MariaDB install uses. The database NAME stays
            forced — that is what tests/TestCase.php checks before it lets
            anything run.
        -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
